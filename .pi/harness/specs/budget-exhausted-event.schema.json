{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ultimate-pi.local/.pi/harness/specs/budget-exhausted-event.schema.json",
	"title": "BudgetExhausted",
	"description": "Structured hard-stop event emitted when debate budget is exhausted.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"contract_version",
		"event_type",
		"run_id",
		"debate_id",
		"round_count",
		"budget_used",
		"exhaustion_reason",
		"caps",
		"minimum_evidence_confidence",
		"default_policy_outcome",
		"human_override_allowed"
	],
	"properties": {
		"schema_version": {
			"type": "string",
			"const": "1.0.0"
		},
		"contract_version": {
			"type": "string",
			"const": "1.0.0"
		},
		"event_type": {
			"type": "string",
			"const": "budget_exhausted"
		},
		"run_id": {
			"type": "string",
			"minLength": 1
		},
		"debate_id": {
			"type": "string",
			"minLength": 1
		},
		"round_count": {
			"type": "integer",
			"minimum": 1,
			"maximum": 6
		},
		"budget_used": {
			"type": "integer",
			"minimum": 0
		},
		"exhaustion_reason": {
			"type": "string",
			"enum": [
				"max_rounds_reached",
				"round_token_cap_exceeded",
				"debate_global_cap_exceeded"
			]
		},
		"caps": {
			"type": "object",
			"additionalProperties": false,
			"required": ["max_rounds", "round_token_cap", "debate_global_cap"],
			"properties": {
				"max_rounds": {
					"type": "integer",
					"const": 6
				},
				"round_token_cap": {
					"type": "integer",
					"const": 2500
				},
				"debate_global_cap": {
					"type": "integer",
					"const": 35000
				}
			}
		},
		"minimum_evidence_confidence": {
			"type": "number",
			"minimum": 0,
			"maximum": 1
		},
		"default_policy_outcome": {
			"type": "string",
			"enum": ["block", "human_required"]
		},
		"human_override_allowed": {
			"type": "boolean",
			"const": true
		}
	}
}
