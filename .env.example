POSTHOG_PERSONAL_API_KEY="phx_your_personal_api_key"
POSTHOG_API_KEY="phc_your_project_key"
# narrow the tool surface
POSTHOG_MCP_FEATURES="llm_analytics"
POSTHOG_PROJECT_NAME="ultimate-pi"
POSTHOG_PRIVACY_MODE="false"
# Harness domain events (harness-telemetry.ts); set false to disable harness_* only
HARNESS_TELEMETRY_ENABLED="true"
# Require Sentrux fitness functions in harness-verify (see .pi/scripts/harness-verify.mjs)
HARNESS_SENTRUX_REQUIRED="true"
# Subagent subprocess timeouts (ms); HARNESS_SUBAGENT_TIMEOUT_DISABLE=1 disables caps
# HARNESS_SUBAGENT_TIMEOUT_PLAN_MS=1800000
# HARNESS_SUBAGENT_TIMEOUT_EXECUTE_MS=2700000
# HARNESS_SUBAGENT_TIMEOUT_REVIEW_MS=1200000
# Sentrux CLI wall-clock cap per check/gate invocation
# HARNESS_SENTRUX_TIMEOUT_MS=300000
# Plan debate wall-clock budget (ms); fast profile defaults lower when unset
# HARNESS_DEBATE_WALL_CLOCK_MS=1200000
# Parallel verdict∥adversary in /harness-review (default off)
# HARNESS_REVIEW_PARALLEL=0
# CocoIndex debounce before subagent spawns (ms); HARNESS_COCOINDEX_REFRESH=0 skips
# HARNESS_COCOINDEX_REFRESH_DEBOUNCE_MS=300000
# Require ls-lint filename fitness in harness-verify (see .pi/scripts/harness-verify.mjs)
HARNESS_LS_LINT_REQUIRED="true"
# ask_user presenter: auto|tui|glimpse|headless (tui for Cursor/WSL without WebView)
HARNESS_ASK_USER_UI=tui
HARNESS_WEB_FETCH_MODE="stealth"
HARNESS_WEB_SEARCH_ENGINE="ddg_html"
# HARNESS_WEB_SEARXNG_URL="http://127.0.0.1:8080"
# HARNESS_WEB_PROXY=
# HARNESS_WEB_RATE_LIMIT_MS=2000
# HARNESS_WEB_TIMEOUT_MS=30000

# VCC compaction (vendored pi-vcc via ultimate-pi-vcc extension; env-only — no config files)
# Default: VCC handles /compact and auto-compaction. Set false to use Pi LLM compaction instead:
# HARNESS_VCC_COMPACTION=false
# HARNESS_VCC_DEBUG=true

# graphify headless extract
OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_API_BASE="https://opencode.ai/zen/go/v1"