/.graphify_detect.json
/.graphify_python
/.graphify_root
/.graphify_incremental.json

# Machine-specific path stamp written by graphify post-commit hook
graphify-books-out/.graphify_root

# Harness runtime (per-developer; specs/, docs/adrs/, evals/smoke/ stay committed)
.pi/harness/active-run.json
.pi/harness/project.json
.pi/harness/release-readiness-report.md
.pi/harness/plans/
.pi/harness/critics/
