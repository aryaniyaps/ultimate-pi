node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Wiki search index (regenerable)
.pi/wiki-search/

# CocoIndex Code semantic index (regenerable)
.cocoindex_code/

# Legacy ck index (removed — safe to delete)
.ck/

# Raw source files (immutable, not committed)
.raw/
raw/

# Vault symlinks (resolve to vault/ for claude-obsidian skills)
/wiki
/.raw
/_templates
/_attachments
/.obsidian
.vault-meta/

# Skill lock file (auto-generated, skip lint)
skills-lock.json
