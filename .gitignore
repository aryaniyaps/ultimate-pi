node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Wiki search index (regenerable)
.pi/wiki-search/

# ck semantic search index (regenerable)
.ck/

# Raw source files (immutable, not committed)
.raw/
raw/

