{
	"$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"maxSize": 5242880,
		"includes": [
			"**/*.{ts,tsx,js,jsx,json,jsonc,css}",
			"!graphify-out/**/*",
			"!graphify-books-out/**/*",
			"!vendor/**/*",
			"!.pi/harness/active-run.json",
			"!.pi/harness/runs/**/run-context.json",
			"!.pi/harness/runs/**/plan-packet.json"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
